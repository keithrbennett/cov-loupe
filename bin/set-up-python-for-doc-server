#!/bin/bash

# Check if script is being sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "Error: This script must be sourced, not executed directly." >&2
  echo "Usage: source bin/set-up-python-for-doc-server" >&2
  echo "   or: . bin/set-up-python-for-doc-server" >&2
  exit 1
fi

if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
  echo "Error: the documentation tools require Python 3.11 or newer, and python3 is older or missing." >&2
  echo "Install Python 3.11 or newer, make sure python3 resolves to it, and run this again." >&2
  return 1
fi

python3 -m venv .docs-venv
source .docs-venv/bin/activate

if [[ -f requirements-lock.txt ]]; then
  pip install -q -r requirements-lock.txt
else
  pip install -q -r requirements.txt
fi
