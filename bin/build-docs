#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds documentation using mkdocs, creating a virtual environment if needed.
# Installs the locked dependencies into the venv on every run, so an existing venv does not
# build with stale packages after requirements-lock.txt changes. When every pin is already
# satisfied this is quick and needs no network access.

SCRIPT_DIR = File.expand_path('..', __dir__)
VENV_DIR = File.join(SCRIPT_DIR, '.docs-venv')

def run(*cmd)
  system(*cmd) || abort("Command failed: #{cmd.join(' ')}")
end

def mkdocs_command
  venv_bin = File.join(VENV_DIR, 'bin')
  mkdocs_path = File.join(venv_bin, 'mkdocs')
  unless File.executable?(mkdocs_path)
    return 'mkdocs' if system('command -v mkdocs > /dev/null 2>&1')

    puts 'Creating virtual environment...'
    run('python3', '-m', 'venv', VENV_DIR)
  end
  run(File.join(venv_bin, 'pip'), 'install', '-q', '-r', File.join(SCRIPT_DIR, 'requirements-lock.txt'))

  mkdocs_path
end

mkdocs = mkdocs_command
# mkdocs reads mkdocs.yml from the current directory
Dir.chdir(SCRIPT_DIR) { run(mkdocs, 'build', '--strict') }
