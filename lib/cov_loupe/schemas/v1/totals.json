{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cov-loupe:schema:v1:totals",
  "title": "cov-loupe v1 project coverage totals",
  "type": "object",
  "required": ["schema_version", "covered", "uncovered", "total", "percentage", "file_globs", "file_counts", "timestamp_status"],
  "properties": {
    "schema_version": {"const": 1, "description": "Version of this payload shape."},
    "covered": {"type": "integer", "minimum": 0, "description": "Covered lines in fresh files (stale files are excluded)."},
    "uncovered": {"type": "integer", "minimum": 0, "description": "Uncovered lines in fresh files."},
    "total": {"type": "integer", "minimum": 0, "description": "Coverable lines in fresh files."},
    "percentage": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Line coverage percent (covered / coverable lines across fresh files), truncated to two decimals; null when there are no such lines."},
    "file_globs": {"type": "array", "items": {"type": "string"}, "description": "Active file glob patterns; empty when none were given."},
    "file_counts": {
      "type": "object",
      "required": ["total", "with_coverage", "without_coverage"],
      "properties": {
        "total": {"type": "integer", "minimum": 0, "description": "Files with or without coverage."},
        "with_coverage": {"$ref": "#/$defs/with_coverage"},
        "without_coverage": {"$ref": "#/$defs/without_coverage"}
      }
    },
    "timestamp_status": {"type": "string", "enum": ["ok", "missing"], "description": "Whether the coverage timestamp is available."},
    "warnings": {"type": "array", "items": {"type": "string"}, "description": "Optional MCP warnings when timestamps are missing or most files were not found under the project root."}
  },
  "$defs": {
    "with_coverage": {
      "type": "object",
      "required": ["total", "ok", "stale"],
      "properties": {
        "total": {"type": "integer", "minimum": 0, "description": "Files with coverage entries."},
        "ok": {"type": "integer", "minimum": 0, "description": "Fresh coverage entries."},
        "stale": {
          "type": "object",
          "required": ["total", "by_type"],
          "properties": {
            "total": {"type": "integer", "minimum": 0, "description": "Stale coverage entries."},
            "by_type": {
              "type": "object",
              "required": ["deleted", "newer", "length_mismatch", "unreadable"],
              "properties": {
                "deleted": {"type": "integer", "minimum": 0, "description": "Sources deleted since coverage was recorded."},
                "newer": {"type": "integer", "minimum": 0, "description": "Sources newer than coverage."},
                "length_mismatch": {"type": "integer", "minimum": 0, "description": "Line-count mismatches."},
                "unreadable": {"type": "integer", "minimum": 0, "description": "Sources that could not be read."}
              }
            }
          }
        }
      }
    },
    "without_coverage": {
      "type": "object",
      "required": ["total", "by_type"],
      "properties": {
        "total": {"type": "integer", "minimum": 0, "description": "Files without usable coverage data: the sum of the by_type counts that are not null."},
        "by_type": {
          "type": "object",
          "required": ["not_in_coverage", "skipped"],
          "properties": {
            "not_in_coverage": {"type": ["integer", "null"], "minimum": 0, "description": "Files matching the file globs that are absent from coverage data; null when no file globs are set, since there is then no list of files to check."},
            "skipped": {"type": "integer", "minimum": 0, "description": "Files skipped because coverage data was invalid."}
          }
        }
      }
    }
  }
}
