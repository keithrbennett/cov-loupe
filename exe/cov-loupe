#!/usr/bin/env ruby
# frozen_string_literal: true

module CovLoupeExecutable
  MINIMUM_RUBY_VERSION = '3.3'
  SIGNAL_EXIT_BASE = 128

  def self.run
    install_signal_handlers
    handle_executable_flags
    ensure_ruby_version!
    original_external = Encoding.default_external
    use_utf8_default_external
    run_application(original_external)
  end

  # Under the C locale (LANG=C), Ruby tags paths from the file system (Dir.pwd, Dir.glob,
  # File.expand_path) as US-ASCII or BINARY, so a non-ASCII path never equals the UTF-8 paths in
  # coverage.json. Make UTF-8 the default for this process then (also when -E sets US-ASCII or
  # BINARY explicitly). A real locale encoding (such as ISO-8859-1) is left alone, because its
  # paths are not UTF-8 bytes.
  def self.use_utf8_default_external
    return unless [Encoding::US_ASCII, Encoding::BINARY].include?(Encoding.default_external)

    verbose = $VERBOSE
    begin
      $VERBOSE = nil # the assignment warns
      Encoding.default_external = Encoding::UTF_8
    ensure
      $VERBOSE = verbose
    end
  end

  def self.install_signal_handlers
    %w[INT TERM].each do |sig|
      Signal.trap(sig) do
        # syswrite skips the IO write lock, which the interrupted code may already hold;
        # IO#write here would raise ThreadError (recursive locking).
        begin
          $stderr.syswrite "\nReceived SIG#{sig}. Exiting.\n"
        rescue SystemCallError, IOError
          # stderr is closed or its reader is gone; still exit with the signal status.
        end
        exit(SIGNAL_EXIT_BASE + Signal.list[sig])
      end
    end
  end

  def self.ensure_ruby_version!(minimum: MINIMUM_RUBY_VERSION)
    return unless defined?(Gem::Version)

    return if Gem::Version.new(RUBY_VERSION) >= Gem::Version.new(minimum)

    $stderr.puts "#{File.basename($PROGRAM_NAME)} requires Ruby >= #{minimum} (current: #{RUBY_VERSION})."
    $stderr.puts 'Please run with a supported Ruby version (e.g., via rbenv, rvm, asdf, mise, rv).'
    exit 1
  end

  def self.handle_executable_flags(argv = ARGV)
    return unless argv.intersect?(%w[-v --version])

    require_relative '../lib/cov_loupe/version'
    puts CovLoupe::VERSION
    exit 0
  end

  # The gem's lib directory, next to this file's exe directory.
  def self.lib_dir
    File.expand_path('../../lib', File.realpath(__FILE__))
  end

  # original_external is Encoding.default_external as the process started; it still decides
  # whether the default output character mode can draw Unicode.
  def self.run_application(original_external)
    lib = lib_dir
    $LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

    require 'cov_loupe'
    require 'cov_loupe/output_chars'
    CovLoupe::OutputChars.fallback_encoding = original_external
    CovLoupe.run(ARGV)
  end
end

CovLoupeExecutable.run
